# eSMART HomeKit bridge (hap-nodejs) as a Linux / Raspberry Pi service.
# Start the bridge service first: this one talks to it over localhost.

[Unit]
Description=eSMART HomeKit bridge (Apple Home)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/esmart/homebridge-esmart
ExecStart=/usr/bin/node esmart-homekit.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
