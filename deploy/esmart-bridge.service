# eSMART bridge as a Linux / Raspberry Pi service (systemd).
#
# 1. Edit the paths below to where this project lives (example: /opt/esmart).
# 2. sudo cp deploy/esmart-bridge.service /etc/systemd/system/
# 3. sudo systemctl daemon-reload
# 4. sudo systemctl enable --now esmart-bridge
# 5. Live logs:  journalctl -u esmart-bridge -f
#
# Restart=always (not on-failure): the bridge can exit 0 after a clean
# XMPP disconnect and systemd would otherwise report "active (exited)"
# forever, leaving the socket dead. always restarts regardless of code.

[Unit]
Description=eSMART local bridge (HTTP + XMPP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/esmart
# keepalive-wrapper.py monkey-patches socket.socket before running the bridge,
# so the XMPP socket gets TCP keepalive without touching upstream Python.
ExecStart=/usr/bin/python3 /opt/esmart/lib/keepalive-wrapper.py /opt/esmart/esmart-bridge.py --port 8090 --host 127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
